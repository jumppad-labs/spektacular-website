---
import SectionHeader from "./SectionHeader.astro";

interface Props {
  heading: string;
  sub?: string;
  surface?: boolean;
  maxWidth?: string;
}

const {
  heading,
  sub,
  surface = false,
  maxWidth = "max-w-[1100px]",
} = Astro.props;

const hasSubSlot = Astro.slots.has("sub");
---
<section class={`py-xl max-sm:py-lg ${surface ? "bg-bg-surface" : ""}`}>
  <div class={`mx-auto ${maxWidth} px-md`}>
    {hasSubSlot ? (
      <SectionHeader heading={heading}>
        <slot name="sub" />
      </SectionHeader>
    ) : (
      <SectionHeader heading={heading} sub={sub} />
    )}
    <div class="spek-section-body">
      <slot />
    </div>
  </div>
</section>
