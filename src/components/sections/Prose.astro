---
interface Props {
  /**
   * Set when this block sits inside a component that already supplies the
   * page section chrome (e.g. <Section>). Renders only the prose article, so
   * the surrounding section's own container and padding govern the width
   * instead of nesting a second, narrower, centred column inside it.
   */
  nested?: boolean;
}

const { nested = false } = Astro.props;

const article =
  "spek-prose prose prose-invert max-w-none prose-headings:text-text-primary prose-h2:mt-12 prose-h2:mb-4 prose-p:text-text-secondary prose-strong:text-text-primary prose-code:text-accent-light prose-code:bg-bg-elevated prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-sm prose-code:text-[0.875em] prose-code:font-mono prose-code:before:content-none prose-code:after:content-none prose-a:text-link-blue prose-a:no-underline hover:prose-a:underline prose-li:text-text-secondary";
---
{nested ? (
  <article class={article}>
    <slot />
  </article>
) : (
  <section class="py-xl max-sm:py-lg">
    <div class="mx-auto max-w-[1100px] px-md">
      <article class={article}>
        <slot />
      </article>
    </div>
  </section>
)}
