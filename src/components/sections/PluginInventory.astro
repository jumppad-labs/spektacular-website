---
import SectionHeader from "./SectionHeader.astro";

interface Props {
  shippingHeading: string;
  shippingSub?: string;
  plannedHeading: string;
  plannedSub?: string;
}

const { shippingHeading, shippingSub, plannedHeading, plannedSub } =
  Astro.props;

const hasShippingSubSlot = Astro.slots.has("shippingSub");
const hasPlannedSubSlot = Astro.slots.has("plannedSub");
---
<section class="py-xl bg-bg-surface max-sm:py-lg">
  <div class="mx-auto max-w-[1100px] px-md">
    {hasShippingSubSlot ? (
      <SectionHeader heading={shippingHeading}>
        <slot name="shippingSub" />
      </SectionHeader>
    ) : (
      <SectionHeader heading={shippingHeading} sub={shippingSub} />
    )}
    <div class="grid grid-cols-3 gap-5 mt-10 max-md:grid-cols-2 max-sm:grid-cols-1">
      <slot name="shipping" />
    </div>
  </div>
</section>

<section class="py-xl max-sm:py-lg">
  <div class="mx-auto max-w-[1100px] px-md">
    {hasPlannedSubSlot ? (
      <SectionHeader heading={plannedHeading}>
        <slot name="plannedSub" />
      </SectionHeader>
    ) : (
      <SectionHeader heading={plannedHeading} sub={plannedSub} />
    )}
    <div class="grid grid-cols-3 gap-5 mt-10 max-md:grid-cols-2 max-sm:grid-cols-1">
      <slot name="planned" />
    </div>
  </div>
</section>
