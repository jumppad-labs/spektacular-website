---
import SectionHeader from "./SectionHeader.astro";

interface Props {
  heading: string;
  sub?: string;
  surface?: boolean;
  body?: string;
  multi?: boolean;
}

const { heading, sub, surface = false, body, multi = false } = Astro.props;

const hasSubSlot = Astro.slots.has("sub");
const hasBodySlot = Astro.slots.has("body");
---
<section class={`py-xl max-sm:py-lg ${surface ? "bg-bg-surface" : ""}`}>
  <div class="mx-auto max-w-[1100px] px-md">
    {hasSubSlot ? (
      <SectionHeader heading={heading}>
        <slot name="sub" />
      </SectionHeader>
    ) : (
      <SectionHeader heading={heading} sub={sub} />
    )}

    {multi ? (
      <div>
        <slot />
      </div>
    ) : (
      <div class="flex items-center justify-center flex-wrap gap-y-4 mt-10 mb-8 max-sm:flex-col">
        <slot />
      </div>
    )}

    {hasBodySlot ? (
      <div class="text-center">
        <div class="spek-body spek-centered text-[0.9375rem] text-text-secondary">
          <slot name="body" />
        </div>
      </div>
    ) : body ? (
      <div class="text-center">
        <p class="spek-body spek-centered text-[0.9375rem] text-text-secondary" set:html={body} />
      </div>
    ) : null}
  </div>
</section>
