---
// Two input nodes sharing one input column that converge, via a bracket, into a
// single arrow feeding the next pipeline step. Pass the nodes through the `top`
// and `bottom` slots. The two rows are a fixed equal height and the nodes a
// fixed equal width, so the bracket meets each node flush at its centre (25% /
// 75% of the pair). On narrow screens it collapses to a single downward arrow,
// like PipelineConnector.
---
<div class="flex items-stretch max-sm:flex-col max-sm:items-center max-sm:gap-y-3">
  <div class="flex flex-col [&>div>*]:min-w-[12rem]">
    <div class="min-h-[9rem] flex items-center justify-center max-sm:min-h-0">
      <slot name="top" />
    </div>
    <div class="min-h-[9rem] flex items-center justify-center max-sm:min-h-0">
      <slot name="bottom" />
    </div>
  </div>
  <div class="relative w-14 self-stretch text-text-muted max-sm:hidden">
    <span class="absolute left-0 top-1/4 w-7 border-t-2 border-current"></span>
    <span class="absolute left-0 bottom-1/4 w-7 border-t-2 border-current"></span>
    <span class="absolute left-7 top-1/4 bottom-1/4 border-l-2 border-current"></span>
    <span class="absolute left-7 top-1/2 -translate-y-1/2 text-xl leading-none">→</span>
  </div>
  <span class="hidden text-text-muted text-xl rotate-90 select-none max-sm:block">→</span>
</div>
