---
type NavItem =
  | { label: string; href: string }
  | { label: string; children: { label: string; href: string }[] };

const items: NavItem[] = [
  { label: "How it works", href: "/how-it-works/" },
  { label: "Knowledge Base", href: "/knowledge-base/" },
  { label: "Tutorials", href: "/tutorials/" },
  { label: "Install", href: "/install/" },
  { label: "Plugins", href: "/plugins/" },
  {
    label: "Resources",
    children: [
      { label: "Configuration", href: "/configuration/" },
      { label: "Repository Configuration", href: "/repo-configuration/" },
      { label: "Extending", href: "/extending/" },
      { label: "Debugging", href: "/debugging/" },
    ],
  },
];

const githubURL = "https://github.com/jumppad-labs/spektacular";
const pathname = Astro.url.pathname;
const matches = (href: string) =>
  pathname === href || (href !== "/" && pathname.startsWith(href));
const isActive = (item: NavItem) =>
  "href" in item
    ? matches(item.href)
    : item.children.some((child) => matches(child.href));
---
<nav class="sticky top-0 z-50 bg-bg-surface/85 backdrop-blur-md border-b border-border-subtle">
  <div class="mx-auto max-w-[1100px] px-md">
    <div class="flex items-center justify-between h-[60px]">
      <a href="/" class="font-extrabold text-lg text-text-primary tracking-tight hover:text-accent-light no-underline">spektacular</a>
      <ul class="flex items-center gap-md max-sm:gap-sm list-none m-0 p-0">
        {items.map((item, i) => (
          <li class={`group relative ${i === 0 ? "max-sm:hidden" : ""}`}>
            {"href" in item ? (
              <a
                href={item.href}
                class={`text-sm transition-colors no-underline ${
                  isActive(item)
                    ? "text-text-primary"
                    : "text-text-secondary hover:text-text-primary"
                }`}
              >
                {item.label}
              </a>
            ) : (
              <>
                <a
                  href={item.children[0].href}
                  tabindex="0"
                  class={`text-sm transition-colors no-underline ${
                    isActive(item)
                      ? "text-text-primary"
                      : "text-text-secondary hover:text-text-primary"
                  }`}
                >
                  {item.label}
                </a>
                <ul class="hidden group-hover:block group-focus-within:block absolute left-0 top-full pt-2 list-none m-0 min-w-[160px]">
                  <li class="flex flex-col gap-1 bg-bg-surface border border-border-subtle rounded-md p-2 shadow-lg">
                    {item.children.map((child) => (
                      <a
                        href={child.href}
                        class={`text-sm transition-colors no-underline px-2 py-1 rounded-sm ${
                          matches(child.href)
                            ? "text-text-primary"
                            : "text-text-secondary hover:text-text-primary"
                        }`}
                      >
                        {child.label}
                      </a>
                    ))}
                  </li>
                </ul>
              </>
            )}
          </li>
        ))}
        <li>
          <a
            href={githubURL}
            class="flex items-center gap-1.5 text-text-secondary hover:text-text-primary text-sm transition-colors no-underline"
            target="_blank"
            rel="noopener"
          >
            <svg class="w-[18px] h-[18px] fill-current" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" />
            </svg>
            GitHub
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>
